<!-- ==============================================================================
     WIDGET CHATBOT AI FLOATING (SISABERBAGI)
     Tempelkan potongan HTML ini di atas tag </body> pada setiap halaman
     (index.html, restoran.html, penerima.html, riwayat.html, tentang.html)
     ============================================================================== -->

<div class="chatbot-wrapper" id="chatbotWrapper">
  <!-- Panel Chatbot -->
  <div class="chatbot-panel" id="chatbotPanel" aria-hidden="true">
    <!-- Header Panel Chatbot -->
    <div class="chatbot-header">
      <div class="chatbot-header-info">
        <div class="chatbot-avatar">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 8V4H8"></path>
            <rect width="16" height="12" x="4" y="8" rx="2"></rect>
            <path d="M2 14h2"></path>
            <path d="M20 14h2"></path>
            <path d="M15 13v2"></path>
            <path d="M9 13v2"></path>
          </svg>
        </div>
        <div>
          <h3 class="chatbot-title">Asisten SisaBerbagi</h3>
          <span class="chatbot-status"><span class="status-dot"></span> Online</span>
        </div>
      </div>
      <button type="button" class="chatbot-close-btn" id="chatbotCloseBtn" aria-label="Tutup Chat">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Area Pesan (Scrollable) -->
    <div class="chatbot-messages" id="chatbotMessages">
      <!-- Pesan sambutan dan riwayat percakapan akan dimuat via JS -->
    </div>

    <!-- Form Input Pesan -->
    <form class="chatbot-input-form" id="chatbotForm">
      <input type="text" id="chatbotInput" class="chatbot-input" placeholder="Tanyakan sesuatu seputar SisaBerbagi..." autocomplete="off" required>
      <button type="submit" class="chatbot-send-btn" id="chatbotSendBtn" aria-label="Kirim Pesan">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="22" y1="2" x2="11" y2="13"></line>
          <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
      </button>
    </form>
  </div>

  <!-- Tombol Bubble Floating -->
  <button type="button" class="chatbot-toggle-btn" id="chatbotToggleBtn" aria-label="Buka Chatbot AI">
    <svg class="icon-chat-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
    </svg>
    <svg class="icon-chat-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>
</div>
